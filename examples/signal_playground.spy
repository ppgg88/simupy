        "phaseDelay": 0.0
      }
    },
    {
      "id": "chirp",
      "type": "Chirp",
      "name": "Chirp",
      "geometry": {
        "x": -420,
        "y": 160,
        "width": 80,
        "height": 60,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "amplitude": 1.0,
        "startFrequency": 0.2,
        "endFrequency": 4.0,
        "sweepTime": 5.0
      }
    },
    {
      "id": "sat",
      "type": "Saturation",
      "name": "Saturation",
      "geometry": {
        "x": -240,
        "y": 20,
        "width": 80,
        "height": 60,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "upperLimit": 0.6,
        "lowerLimit": -0.6
      }
    },
    {
      "id": "filter",
