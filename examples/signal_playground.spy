{
  "format": "simupy-model",
  "version": 1,
  "name": "signal playground",
  "solver": {
    "method": "rk45",
    "startTime": 0.0,
    "stopTime": 5.0,
    "fixedStep": 0.001,
    "maxStep": 0.0,
    "minStep": 1e-12,
    "initialStep": 0.0,
    "relTol": 0.0001,
    "absTol": 1e-07,
    "maxLoggedSamples": 200000
  },
  "blocks": [
    {
