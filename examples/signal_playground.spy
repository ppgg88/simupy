        "phase": 0.0,
        "bias": [
          0.0
        ]
      }
    },
    {
      "id": "pulse",
      "type": "Pulse",
      "name": "Pulse",
      "geometry": {
        "x": -420,
        "y": 20,
        "width": 80,
        "height": 60,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "amplitude": 1.0,
        "period": 1.0,
