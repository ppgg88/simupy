      "geometry": {
        "x": -240,
        "y": 160,
        "width": 120,
        "height": 60,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "numerator": [
          1.0
        ],
        "denominator": [
          0.15,
          1.0
        ]
      }
    },
    {
      "id": "mux",
      "type": "Mux",
      "name": "Mux",
      "geometry": {
        "x": -40,
        "y": 0,
        "width": 24,
        "height": 110,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "inputs": 3.0
      }
    },
    {
