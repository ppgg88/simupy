      "geometry": {
        "x": -560,
        "y": 300,
        "width": 100,
        "height": 55,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "offValue": 0.0,
        "onValue": 0.6
      }
    },
    {
      "id": "error",
