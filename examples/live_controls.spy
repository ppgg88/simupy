      "name": "Error",
      "geometry": {
        "x": -380,
        "y": 0,
        "width": 50,
        "height": 60,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "signs": "+-"
      }
    },
    {
      "id": "pid",
