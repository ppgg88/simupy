{
  "format": "simupy-model",
  "version": 1,
  "name": "live controls",
  "solver": {
    "method": "rk45",
    "startTime": 0.0,
    "stopTime": 30.0,
    "fixedStep": 0.001,
    "maxStep": 0.02,
    "minStep": 1e-12,
    "initialStep": 0.0,
    "relTol": 0.0001,
    "absTol": 1e-07,
    "maxLoggedSamples": 200000,
    "realTime": true,
    "realTimeFactor": 1.0
  },
  "blocks": [
    {
      "id": "setpoint",
      "type": "Slider",
      "name": "Setpoint",
      "geometry": {
        "x": -560,
        "y": 0,
        "width": 100,
        "height": 55,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "minimum": -2.0,
        "maximum": 2.0,
        "value": 1.0,
        "step": 0.05
      },
      "signals": {
        "0": "setpoint"
      }
    },
    {
      "id": "enable",
      "type": "Toggle",
      "name": "Integral action",
      "geometry": {
        "x": -560,
        "y": 150,
        "width": 100,
        "height": 55,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "on": true,
        "offValue": 0.0,
        "onValue": 1.0
      }
    },
    {
      "id": "kick",
