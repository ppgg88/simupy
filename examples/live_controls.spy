      "name": "Injected",
      "geometry": {
        "x": -50,
        "y": 0,
        "width": 50,
        "height": 60,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "signs": "++"
      }
    },
    {
      "id": "plant",
