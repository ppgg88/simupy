        "x": -280,
        "y": 0,
        "width": 90,
        "height": 60,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "kp": 3.0,
        "ki": 2.0,
        "kd": 0.2
      }
    },
    {
      "id": "gate",
      "type": "Product",
      "name": "Gate",
      "geometry": {
        "x": -150,
        "y": 0,
        "width": 50,
        "height": 60,
        "rotation": 0,
        "mirrored": false
      },
      "params": {
        "inputs": 2.0
      }
    },
    {
      "id": "inject",
